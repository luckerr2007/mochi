{
  "name": "mochi",
  "private": true,
  "version": "0.0.0",
  "description": "Mochi — cartoon-soft Vue 3 component library with runtime-swappable design tokens.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter mochi-island-ui build",
    "test": "pnpm --filter mochi-island-ui test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "docs:dev": "pnpm build && pnpm --filter docs dev",
    "docs:build": "pnpm build && pnpm --filter docs build",
    "pack:check": "pnpm build && pnpm --filter mochi-island-ui exec npm pack --dry-run",
    "lint": "eslint . && stylelint \"packages/mochi-island-ui/src/**/*.css\" \"playground/src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"packages/mochi-island-ui/src/**/*.css\" \"playground/src/**/*.css\" --fix",
    "format": "prettier --write \"packages/mochi-island-ui/src/**/*.{ts,vue,css}\" \"playground/src/**/*.{ts,vue,css}\"",
    "test:visual": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3"
  }
}

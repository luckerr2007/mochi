{
  "name": "mochi-island-ui",
  "version": "1.2.0",
  "description": "Cartoon-soft Vue 3 component library. Design tokens are the API.",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "design-tokens",
    "css-variables"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./style.css": "./dist/style.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./package.json": "./package.json",
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    }
  },
  "scripts": {
    "build": "vite build && node scripts/copy-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "unplugin-vue-components": ">=0.27.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "unplugin-vue-components": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "unplugin-vue-components": ">=0.27.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
